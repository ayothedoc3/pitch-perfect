# Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://api.pitchbuddy.online/api

# Backend Environment Variables (for server directory)
# Copy these to server/.env
DATABASE_URL="postgresql://username:password@localhost:5432/pitchbuddy?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
OPENAI_API_KEY="I have my open ai api key on coolify now your-openai-api-key"
NODE_ENV="development"
PORT=3001
FRONTEND_URL="https://www.pitchbuddy.online"
FRONTEND_URLS="http://localhost:3000,http://localhost:3003,http://localhost:3004"
UPLOAD_MAX_SIZE=100000000
UPLOAD_DIR="./uploads"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15

# Production Environment Variables for Coolify
# Set these in your Coolify deployment environment variables
POSTGRES_DB=pitchbuddy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password

# Production URLs (replace with your actual domains)
FRONTEND_URL=https://www.pitchbuddy.online
BACKEND_URL=https://api.pitchbuddy.online
NEXT_PUBLIC_API_URL=https://api.pitchbuddy.online/api
