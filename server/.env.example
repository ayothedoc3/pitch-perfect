# Database
DATABASE_URL="postgresql://username:password@localhost:5432/pitch_perfect?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key-here"
JWT_EXPIRES_IN="7d"

# OpenAI API
OPENAI_API_KEY="your-openai-api-key"

# Server
PORT=3001
NODE_ENV="development"

# File Storage
UPLOAD_MAX_SIZE=100000000
UPLOAD_DIR="./uploads"

# CORS
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15